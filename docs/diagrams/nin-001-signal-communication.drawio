        <mxCell id="l1" style="endArrow=none;dashed=1;html=0;strokeColor=#b0a24f;" edge="1" parent="1" source="n1" target="C">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="T2 et T3 : nouveau trace_id, pas de baggage ; reliées par span links, vérifiées en live [D]&#10;• T2 : batch credential (LINK_CREDENTIAL_BATCH)&#10;• T3 : livraison WebSub vers ida-internal (LINK_WEBSUB_DELIVERY)&#10;Sur MOSIP réel : à implémenter (WP0-SW-04)" style="shape=note;whiteSpace=wrap;html=0;size=14;fillColor=#fffde7;strokeColor=#b0a24f;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1960" y="570" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="leg" value="Lecture : objets = instances « nom : rôle (span attendu, kind) » · flèches pleines = appels propageant le contexte · flèches pointillées = export OTLP · 1.x dans pkr, 2.x étapes regproc, 3–4 pipeline, 5 vérification oracle." style="text;html=0;whiteSpace=wrap;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1800" height="40" as="geometry" />
        </mxCell>
