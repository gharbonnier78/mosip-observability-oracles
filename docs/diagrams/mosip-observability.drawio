        <mxCell id="ea7" value="⑧ ouvre l'URL Grafana : arbre de spans + logs + métriques" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.35;" edge="1" parent="1" source="a5" target="e1">
          <mxGeometry relative="1" as="geometry">
