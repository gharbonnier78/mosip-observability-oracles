<mxCell id="c16_5" value="jarvis_assertions_total{result}" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="970" y="1592" width="220" height="92" as="geometry"/></mxCell>
<mxCell id="c16_6" value="IDA AUTH event" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1190" y="1592" width="170" height="92" as="geometry"/></mxCell>
<mxCell id="c16_7" value="status PROCESSED within SLO, identity readable, demo auth with VID authStatus=true" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1360" y="1592" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="c17_0" value="ALL" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="1684" width="60" height="92" as="geometry"/></mxCell>
<mxCell id="c17_1" value="all services" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="80" y="1684" width="160" height="92" as="geometry"/></mxCell>
<mxCell id="c17_2" value="-" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="240" y="1684" width="220" height="92" as="geometry"/></mxCell>
<mxCell id="c17_3" value="0 unexpected ERROR spans, no span above budget, span count per contract" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="460" y="1684" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="c17_4" value="no ERROR log with T or RID, no UIN in clear" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="760" y="1684" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="c17_5" value="p95 per stage &amp;le; budget, no restart / OOMKilled, Kafka lag back to 0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="970" y="1684" width="220" height="92" as="geometry"/></mxCell>
<mxCell id="c17_6" value="audit count = contract" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1190" y="1684" width="170" height="92" as="geometry"/></mxCell>
<mxCell id="c17_7" value="E2E RID &amp;rarr; UIN &amp;le; SLO (e.g. 10 min)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1360" y="1684" width="300" height="92" as="geometry"/></mxCell>
</root></mxGraphModel></diagram><diagram id="nin-evidence" name="5 - Evidence collection and verdict"><mxGraphModel dx="2400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2470" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t5" value="&lt;b&gt;5 - End of test: evidence collection via observability and audit APIs, verification, verdict classification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Goal: prove functional and non-functional expectations AND prove that every expected signal / audit was produced - a KO can come from a product bug, the infrastructure, or a missing evidence / signal.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="2400" height="60" as="geometry"/></mxCell>
<mxCell id="zc" value="Jarvis Evidence Collector (runs after the last assertion)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="620" height="920" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;b&gt;1 - Close ROOT span and flush&lt;/b&gt;&lt;br&gt;ROOT span ends (test.verdict pending), SDK forceFlush(). Settle window = batch timeout + tail_sampling decision_wait (e.g. 30 s) + Loki ingestion; poll until span / log counts are stable twice." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;2 - Resolve the trace set&lt;/b&gt;&lt;br&gt;Tempo TraceQL {span.test.case.id=&quot;TC_NIN_001&quot; &amp;amp;&amp;amp; span.test.run.id=&quot;RUN&quot;} + async traces {span.mosip.rid=&quot;RID&quot;} + span links &amp;rarr; list of trace_ids." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;3 - Fetch traces&lt;/b&gt;&lt;br&gt;GET /api/v2/traces/{traceId} (OTLP JSON) for each trace &amp;rarr; traces/*.json. Rebuild span tree, root span_id, durations, status, exceptions." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;4 - Fetch logs&lt;/b&gt;&lt;br&gt;Loki GET /loki/api/v1/query_range, query {namespace=~&quot;mosip.*&quot;} | json | trace_id=~&quot;T1|T2&quot; or rid=&quot;RID&quot; &amp;rarr; logs.ndjson." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;5 - Fetch metrics&lt;/b&gt;&lt;br&gt;Mimir GET /prometheus/api/v1/query at t_start and t_end (deltas), query_range, /api/v1/query_exemplars &amp;rarr; metrics.json." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;6 - Fetch audits&lt;/b&gt;&lt;br&gt;Loki tenant audit (header X-Scope-OrgID: audit) + read-only SQL on mosip_audit.app_audit_log WHERE ref_id IN (RID, uin_hash, VID) &amp;rarr; audit.json." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;7 - Fetch business state&lt;/b&gt;&lt;br&gt;registrationstatus/search + registration_transaction chain, ID Repo identity and VID, GET /v1/credentialrequest/get/{requestId}, IDA auth result, mock SMTP / SMS inbox &amp;rarr; business.json." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="698" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es6" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;8 - Fetch infra and pipeline context&lt;/b&gt;&lt;br&gt;kube_pod_container_status_restarts_total, ..._last_terminated_reason, node pressure, K8s events; otelcol_receiver_refused_*, otelcol_exporter_send_failed_*, canary span &amp;rarr; context.json." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="796" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es7" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s8" value="&lt;b&gt;9 - Seal the evidence bundle&lt;/b&gt;&lt;br&gt;manifest.json (ids, time window, trace_ids, exact queries, versions) + SHA-256 per file, signature (POST /v1/keymanager/jwtSign or cosign), upload to s3://evidence-worm/RUN/TC (Object Lock), attach to Allure with Grafana URLs." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="580" height="88" as="geometry"/></mxCell>
<mxCell id="es8" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="bundle" value="evidence/RUN/TC_NIN_001/&#xa;|- manifest.json + signature.jws&#xa;|- traces/{trace_id}.json&#xa;|- logs.ndjson&#xa;|- metrics.json (before / after, exemplars)&#xa;|- audit.json&#xa;|- business.json (RID, uin_hash, VID, statuses)&#xa;|- context.json (infra + pipeline health)&#xa;|- verdict.json (oracles, coverage, class)&#xa;|- links.md (Grafana Explore / dashboards)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="110" width="460" height="200" as="geometry"/></mxCell>
<mxCell id="bundleT" value="&lt;b&gt;Evidence bundle (immutable, signed)&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="80" width="460" height="28" as="geometry"/></mxCell>
<mxCell id="eb9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s8" target="bundle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="938"/><mxPoint x="660" y="210"/></Array></mxGeometry></mxCell>
<mxCell id="ve" value="Verification engine" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="340" width="460" height="655" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;Functional oracle&lt;/b&gt;&lt;br&gt;&amp;bull; data model: identity JSON valid against ID schema vX (A3); field-by-field equality with packet demographics; documents and biometrics present&lt;br&gt;&amp;bull; rules: RID 29 digits; UIN 10 digits, Verhoeff, no leading 0/1, no sequences; VID 16 digits Perpetual ACTIVE&lt;br&gt;&amp;bull; generated elements: UIN, VID, credential ISSUED, IDA identity_cache, notification received&lt;br&gt;&amp;bull; status chain: all expected transactions SUCCESS in order, final PROCESSED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="705" y="370" width="430" height="150" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;Non-functional oracle&lt;/b&gt;&lt;br&gt;&amp;bull; E2E RID &amp;rarr; UIN &amp;le; SLO; per-stage p95 &amp;le; budget (span durations)&lt;br&gt;&amp;bull; 0 unexpected ERROR spans / logs; retries &amp;le; 1; Kafka lag back to 0&lt;br&gt;&amp;bull; no restart / OOMKilled in window&lt;br&gt;&amp;bull; security: UIN and biometrics never in clear in logs / spans" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="705" y="530" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="o3" value="# Signal-completeness contract (nin-e2e.contract.yaml)&#xa;spans:&#xa;  - service: regproc-pkr&#xa;    name: POST /registrationprocessor/v1/packetreceiver/registrationpackets&#xa;    status: OK&#xa;  - service: kernel-idgenerator&#xa;    name: GET /v1/idgenerator/uin&#xa;  - service: id-repository&#xa;    name: POST /idrepository/v1/identity/&#xa;logs:&#xa;  - service: regproc-group*&#xa;    match: &apos;rid={RID}&apos;&#xa;audits:&#xa;  - module: UIN_GENERATOR&#xa;    ref_id: &apos;{RID}&apos;&#xa;    min: 1&#xa;metrics:&#xa;  - expr: increase(http_server_requests_seconds_count{uri=&apos;/v1/idgenerator/uin&apos;}[{window}])&#xa;    min: 1&#xa;# coverage = found / expected  -&gt; 100 % required" style="rounded=1;whiteSpace=wrap;html=0;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontFamily=Courier New;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="705" y="640" width="430" height="345" as="geometry"/></mxCell>
