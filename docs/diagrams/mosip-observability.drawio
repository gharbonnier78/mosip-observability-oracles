<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17">
  <diagram id="archi" name="1 - Architecture Observabilité &amp; Audit">
    <mxGraphModel dx="2400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Architecture Observabilité &amp;amp; Audit – Environnements de test MOSIP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;OpenTelemetry · Prometheus / Mimir · Tempo · Loki · Grafana – traçabilité E2E (trace_id / span_id / transactionID / rid)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1600" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Zone A : Tests ===== -->
        <mxCell id="zA" value="CI &amp;amp; Tests E2E automatisés" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="360" height="800" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Pipeline CI&lt;/b&gt; (GitLab CI / Jenkins)&lt;br&gt;déclenche la campagne E2E · génère &lt;i&gt;test.run.id&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;MOSIP E2E Test Rig&lt;/b&gt;&lt;br&gt;(apitest-rig · TestNG + RestAssured)&lt;br&gt;+ OTel Java Agent + BaggageSpanProcessor&lt;br&gt;• 1 span racine par test case&lt;br&gt;• W3C &lt;i&gt;traceparent&lt;/i&gt; + &lt;i&gt;baggage&lt;/i&gt; : test.run.id, test.case.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Trace Resolver / Correlation API&lt;/b&gt;&lt;br&gt;(script Python/Go, appelé en fin de test case)&lt;br&gt;• TraceQL : span.test.case.id=…&lt;br&gt;• LogQL : | json | trace_id=…&lt;br&gt;• PromQL : spanmetrics, JVM, infra&lt;br&gt;→ {trace_id, span_id, transaction_id, rid}&lt;br&gt;→ URLs Grafana (Explore / dashboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Rapport de test&lt;/b&gt; (Allure / ExtentReports)&lt;br&gt;par test case : trace_id, transactionID, lien Grafana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Dev / QA / SRE&lt;br&gt;(investigation)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="185" y="600" width="30" height="60" as="geometry" />
