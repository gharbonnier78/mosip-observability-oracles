        <mxCell id="ea6" value="⑧ consulte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry" />
