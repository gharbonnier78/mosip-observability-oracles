        <!-- ===== Zone C : Pipeline ===== -->
        <mxCell id="zC" value="Pipeline de télémétrie" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1220" y="80" width="300" height="800" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;OTel Collector – Gateway&lt;/b&gt;&lt;br&gt;(Deployment HA, 2+ replicas)&lt;br&gt;&lt;br&gt;&lt;b&gt;receivers&lt;/b&gt; : otlp&lt;br&gt;&lt;br&gt;&lt;b&gt;processors&lt;/b&gt; :&lt;br&gt;• memory_limiter, batch&lt;br&gt;• transform : transactionID, rid, test.run.id → attributs&lt;br&gt;• tail_sampling : 100 % si test.run.id ou erreur, sinon 10 %&lt;br&gt;• redaction (PII : UIN, VID, biométrie)&lt;br&gt;• routing : logs d'audit → tenant « audit »&lt;br&gt;&lt;br&gt;&lt;b&gt;connectors&lt;/b&gt; :&lt;br&gt;• spanmetrics (RED + exemplars)&lt;br&gt;• servicegraph&lt;br&gt;&lt;br&gt;&lt;b&gt;exporters&lt;/b&gt; :&lt;br&gt;• otlp → Tempo&lt;br&gt;• otlphttp → Loki (/otlp)&lt;br&gt;• prometheusremotewrite → Mimir" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1235" y="130" width="270" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Option : exporter &lt;i&gt;loadbalancing&lt;/i&gt; (routage par traceID) devant les gateways pour un tail sampling cohérent" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1235" y="565" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Prometheus (scrape)&lt;/b&gt;&lt;br&gt;ServiceMonitors : /actuator/prometheus, exporters, kube-state-metrics&lt;br&gt;→ remote_write Mimir (exemplars activés)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1235" y="660" width="270" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Zone D : Backends ===== -->
        <mxCell id="zD" value="Backends (stockage)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1560" y="80" width="300" height="800" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Grafana Tempo&lt;/b&gt;&lt;br&gt;Traces (TraceQL)&lt;br&gt;metrics-generator (service graph)&lt;br&gt;rétention 14 j" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1590" y="130" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Grafana Loki&lt;/b&gt;&lt;br&gt;Logs (LogQL)&lt;br&gt;tenant app : 14 j&lt;br&gt;tenant audit : 1 an+" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1590" y="270" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Prometheus / Mimir&lt;/b&gt;&lt;br&gt;Métriques (PromQL)&lt;br&gt;exemplars → trace_id&lt;br&gt;rétention 30 j" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1590" y="410" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Pyroscope (optionnel)&lt;br&gt;profils continus ↔ spans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1590" y="555" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;Stockage objet S3 / MinIO&lt;/b&gt;&lt;br&gt;chunks &amp;amp; blocks Tempo / Loki / Mimir&lt;br&gt;bucket audit : Object Lock (WORM)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1590" y="650" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Zone E : Visualisation / Audit ===== -->
        <mxCell id="zE" value="Visualisation, alerting &amp;amp; audit" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1900" y="80" width="320" height="800" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;Grafana&lt;/b&gt; (Explore · Traces Drilldown)&lt;br&gt;Datasources corrélées :&lt;br&gt;• Tempo → Loki (traceToLogs, trace_id)&lt;br&gt;• Tempo → Mimir (traceToMetrics)&lt;br&gt;• Loki → Tempo (derivedFields trace_id)&lt;br&gt;• exemplars Mimir → Tempo&lt;br&gt;• Service Graph / Node graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1920" y="130" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Dashboards provisionnés (as code)&lt;/b&gt;&lt;br&gt;• MOSIP E2E Test Run (var. test.run.id)&lt;br&gt;• RED par service (spanmetrics)&lt;br&gt;• Registration Processor (stages)&lt;br&gt;• JVM / Kafka / Postgres / K8s&lt;br&gt;• Audit &amp;amp; sécurité" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1920" y="350" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;Grafana Alerting / Alertmanager&lt;/b&gt;&lt;br&gt;→ Teams / Slack / Mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1920" y="530" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;Piste d'audit&lt;/b&gt;&lt;br&gt;• audit MOSIP (kernel-auditmanager) + audit API K8s&lt;br&gt;• tenant Loki dédié, RBAC restreint&lt;br&gt;• immuable (WORM), horodatage&lt;br&gt;• recherche par transactionID / rid / trace_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1920" y="640" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- ===== Légende ===== -->
        <mxCell id="leg" value="&lt;b&gt;Flux&lt;/b&gt;&lt;br&gt;① Le pipeline CI lance la campagne E2E MOSIP (test.run.id).  ② Le test rig ouvre un span racine par test case et propage traceparent + baggage via l'ingress.  ③ Les services MOSIP créent les spans enfants (HTTP, JDBC, Kafka) et écrivent des logs JSON contenant trace_id.&lt;br&gt;④ Les agents OTel collectent traces, logs et métriques et les enrichissent (k8sattributes).  ⑤ La gateway applique sampling, redaction, spanmetrics/servicegraph et routage, puis exporte vers Tempo / Loki / Mimir.&lt;br&gt;⑦ En fin de test, le Trace Resolver interroge les backends et produit {trace_id, span_id, transaction_id, rid} + URL Grafana.  ⑧ L'URL est injectée dans le rapport ; l'investigateur ouvre Grafana : arbre de spans + logs + métriques corrélés.&lt;br&gt;&lt;b&gt;Clés de corrélation :&lt;/b&gt; trace_id / span_id (W3C) · test.run.id / test.case.id (baggage → attributs) · transactionID / rid (MOSIP, MDC → attributs) · k8s.pod.name / service.name (resource)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="935" width="2200" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="ea1" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
