        <mxCell id="bmw" value="Middleware &amp;amp; données (métriques via exporters)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="720" height="110" as="geometry" />
