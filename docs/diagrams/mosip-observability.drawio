          </mxGeometry>
        </mxCell>
        <mxCell id="ea8" value="⑦ API Grafana (proxy datasources) : TraceQL / LogQL / PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9673a6;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.2;" edge="1" parent="1" source="a3" target="e1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="28" y="405" /><mxPoint x="28" y="915" /><mxPoint x="2255" y="915" /><mxPoint x="2255" y="170" /></Array>
