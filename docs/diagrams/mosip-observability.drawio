<mxCell id="p4" value="&lt;b&gt;Tempo&lt;/b&gt;&lt;br&gt;traces" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="140" height="70" as="geometry"/></mxCell>
