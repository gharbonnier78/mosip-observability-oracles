        <mxCell id="b2" value="&lt;b&gt;OTel Collector – Agent&lt;/b&gt; (DaemonSet, 1 par nœud)&lt;br&gt;receivers : otlp (4317/4318), filelog (/var/log/pods – logs JSON MOSIP), kubeletstats, hostmetrics&lt;br&gt;processors : memory_limiter, k8sattributes (pod, namespace, deployment), resourcedetection, batch&lt;br&gt;exporter : otlp → Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="720" height="100" as="geometry" />
