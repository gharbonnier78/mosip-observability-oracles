<mxCell id="tip" value="&lt;b&gt;Every verdict is written to verdict.json and set on the ROOT span&lt;/b&gt; (test.verdict, test.root_cause) and pushed as a Grafana annotation on the run dashboard." style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="960" width="1200" height="28" as="geometry"/></mxCell>
<mxCell id="api" value="# Observability and audit API cheat-sheet (service-account tokens, read-only)&#xa;# Tempo&#xa;GET  $TEMPO/api/search?q={ span.test.run.id=&quot;RUN&quot; &amp;&amp; span.test.case.id=&quot;TC_NIN_001&quot; }&amp;start=&lt;unix&gt;&amp;end=&lt;unix&gt;&amp;limit=100&#xa;GET  $TEMPO/api/v2/traces/&lt;traceId&gt;&#xa;# Loki (tenant app / audit)&#xa;GET  $LOKI/loki/api/v1/query_range?query={namespace=~&quot;mosip.*&quot;} | json | rid=&quot;RID&quot;&amp;start=&lt;ns&gt;&amp;end=&lt;ns&gt;&amp;limit=5000&amp;direction=forward      (header X-Scope-OrgID: app)&#xa;GET  $LOKI/loki/api/v1/query_range?query={stream=&quot;mosip-audit&quot;} | json | ref_id=~&quot;RID|&lt;uin_hash&gt;|VID&quot;&amp;start=&lt;ns&gt;&amp;end=&lt;ns&gt;                    (header X-Scope-OrgID: audit)&#xa;# Mimir / Prometheus&#xa;GET  $MIMIR/prometheus/api/v1/query?query=sum by (service_name, span_name, status_code) (increase(traces_span_metrics_calls_total{service_name=~&quot;regproc.*|id-repository|kernel.*|id-authentication&quot;}[15m]))&amp;time=&lt;t_end&gt;&#xa;GET  $MIMIR/prometheus/api/v1/query_exemplars?query=traces_span_metrics_duration_milliseconds_bucket&amp;start=&lt;t0&gt;&amp;end=&lt;t1&gt;&#xa;# Via Grafana (single auth point)&#xa;GET  $GRAFANA/api/datasources/proxy/uid/&lt;tempo-uid&gt;/api/v2/traces/&lt;traceId&gt;      POST $GRAFANA/api/ds/query (Loki / Mimir)&#xa;# Investigation URL stored in links.md and Allure&#xa;$GRAFANA/explore?schemaVersion=1&amp;panes={&quot;a&quot;:{&quot;datasource&quot;:&quot;tempo&quot;,&quot;queries&quot;:[{&quot;refId&quot;:&quot;A&quot;,&quot;queryType&quot;:&quot;traceql&quot;,&quot;query&quot;:&quot;&lt;traceId&gt;&quot;}],&quot;range&quot;:{&quot;from&quot;:&quot;&lt;t0&gt;&quot;,&quot;to&quot;:&quot;&lt;t1&gt;&quot;}}}" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="2430" height="250" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="nin-obsflow" name="6 - NIN-001 observability and audit flow"><mxGraphModel dx="2400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1346" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="band11" value="1. Signal production during the test (W3C context everywhere, env/site stamped by the cluster collector)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontSize=11;spacingLeft=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="10" y="180" width="2250" height="328" as="geometry"/></mxCell>
<mxCell id="band22" value="2. Settle window, then evidence collection through observability and audit APIs (read-only service accounts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontSize=11;spacingLeft=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="10" y="512" width="2250" height="362" as="geometry"/></mxCell>
<mxCell id="band28" value="3. Verification against the oracle and reporting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontSize=11;spacingLeft=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="10" y="878" width="2250" height="192" as="geometry"/></mxCell>
<mxCell id="band32" value="4. Investigation from the report (same stores, same keys)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;fontStyle=1;fontSize=11;spacingLeft=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="10" y="1074" width="2250" height="166" as="geometry"/></mxCell>
<mxCell id="t6" value="&lt;b&gt;6 - NIN-001 observability and audit flow: signal production, evidence collection, verification, report, investigation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Every arrow is a real interface. Signals carry trace_id / span_id (W3C), cicd.pipeline.run.id, test.case.name (baggage), mosip.rid, deployment.environment.name, k8s.cluster.name, acme.site.name. Evidence is read through the same stores operations use, then sealed (SHA-256 + signature, object lock).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="2200" height="60" as="geometry"/></mxCell>
<mxCell id="p0" value="&lt;b&gt;Jarvis&lt;/b&gt;&lt;br&gt;test executor&lt;br&gt;&lt;i&gt;jarvis-e2e&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;MOSIP&lt;/b&gt;&lt;br&gt;system under test&lt;br&gt;(all services)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="180" y="80" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;OTel Collector&lt;/b&gt;&lt;br&gt;agent (DaemonSet)&lt;br&gt;k8s attrs, env/site" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="140" height="70" as="geometry"/></mxCell>
