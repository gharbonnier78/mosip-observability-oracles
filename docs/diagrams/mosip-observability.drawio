        <mxCell id="m1" value="Kafka / ActiveMQ&lt;br&gt;+ kafka-exporter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
