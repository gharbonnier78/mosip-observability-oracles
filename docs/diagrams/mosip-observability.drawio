          <mxGeometry x="810" y="730" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="Logs MOSIP (logback) en JSON avec MDC &lt;b&gt;trace_id / span_id / transactionID / rid&lt;/b&gt; → corrélation logs ↔ traces. Micrometer /actuator/prometheus avec exemplars." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="805" width="720" height="60" as="geometry" />
