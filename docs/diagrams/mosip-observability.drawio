<mxCell id="c15_7" value="mock inbox holds the UIN notification for the resident" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#f7f9fc;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1360" y="1500" width="300" height="92" as="geometry"/></mxCell>
<mxCell id="c16_0" value="F1-F3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="1592" width="60" height="92" as="geometry"/></mxCell>
<mxCell id="c16_1" value="jarvis-e2e" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="80" y="1592" width="160" height="92" as="geometry"/></mxCell>
<mxCell id="c16_2" value="registrationstatus/search, identity/idvid, IDA auth" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="240" y="1592" width="220" height="92" as="geometry"/></mxCell>
<mxCell id="c16_3" value="CLIENT child spans of ROOT (one per poll / check)&lt;br&gt;attr test.step" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fillColor=#ffffff;strokeColor=#bfbfbf;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="460" y="1592" width="300" height="92" as="geometry"/></mxCell>
