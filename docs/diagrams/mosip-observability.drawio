<mxCell id="p8" value="&lt;b&gt;MOSIP DBs&lt;/b&gt;&lt;br&gt;audit, regprc, idrepo&lt;br&gt;(read-only replica)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1300" y="80" width="140" height="70" as="geometry"/></mxCell>
