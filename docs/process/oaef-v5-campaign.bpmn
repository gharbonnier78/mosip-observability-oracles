<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="oaef-v5" targetNamespace="https://github.com/gharbonnier78/mosip-observability-oracles">
  <collaboration id="Collab">
    <participant id="P_engineer" name="Test engineer (person)" processRef="Proc_engineer"/>
    <participant id="P_ci" name="GitHub Actions: OAEF scripts (no AI at run time)" processRef="Proc_ci"/>
    <messageFlow id="M1" name="run request" sourceRef="E_trigger" targetRef="C_start"/>
    <messageFlow id="M2" name="reports, evidence, zip" sourceRef="C_export" targetRef="E_investigate"/>
  </collaboration>
  <process id="Proc_engineer" isExecutable="false">
    <startEvent id="E_start" name="Campaign needed"><outgoing>F1</outgoing></startEvent>
    <task id="E_spec" name="Write / review specification (models, oracle YAML)"><incoming>F1</incoming><outgoing>F2</outgoing></task>
    <task id="E_trigger" name="Trigger campaign (gh workflow run)"><incoming>F2</incoming></task>
    <task id="E_investigate" name="Investigate report, Grafana, screenshots"><outgoing>F3</outgoing></task>
    <exclusiveGateway id="E_gw" name="Defect?"><incoming>F3</incoming><outgoing>F4</outgoing><outgoing>F5</outgoing></exclusiveGateway>
    <task id="E_raise" name="Raise defect with run id and evidence zip"><incoming>F4</incoming><outgoing>F6</outgoing></task>
    <endEvent id="E_end" name="Campaign closed"><incoming>F5</incoming><incoming>F6</incoming></endEvent>
    <sequenceFlow id="F1" name="" sourceRef="E_start" targetRef="E_spec"/>
    <sequenceFlow id="F2" name="" sourceRef="E_spec" targetRef="E_trigger"/>
    <sequenceFlow id="F3" name="" sourceRef="E_investigate" targetRef="E_gw"/>
    <sequenceFlow id="F4" name="yes" sourceRef="E_gw" targetRef="E_raise"/>
    <sequenceFlow id="F5" name="no" sourceRef="E_gw" targetRef="E_end"/>
    <sequenceFlow id="F6" name="" sourceRef="E_raise" targetRef="E_end"/>
  </process>
  <process id="Proc_ci" isExecutable="false">
    <startEvent id="C_start" name="workflow_dispatch"><outgoing>F7</outgoing></startEvent>
    <scriptTask id="C_compile" name="Compile specification, drift check"><incoming>F7</incoming><outgoing>F8</outgoing></scriptTask>
    <scriptTask id="C_stack" name="Start Grafana LGTM (pinned)"><incoming>F8</incoming><outgoing>F9</outgoing></scriptTask>
    <scriptTask id="C_case" name="Simulate journey, inject fault (S1)"><incoming>F9</incoming><incoming>F13</incoming><outgoing>F10</outgoing></scriptTask>
    <scriptTask id="C_collect" name="Collect from Tempo, Loki, Prometheus"><incoming>F10</incoming><outgoing>F11</outgoing></scriptTask>
    <scriptTask id="C_verdict" name="Oracle verdict, classify, seal (SHA-256)"><incoming>F11</incoming><outgoing>F12</outgoing></scriptTask>
    <exclusiveGateway id="C_gw" name="More cases?"><incoming>F12</incoming><outgoing>F13</outgoing><outgoing>F14</outgoing></exclusiveGateway>
    <scriptTask id="C_export" name="Allure, Playwright screenshots, zip, Xray JSON"><incoming>F14</incoming><outgoing>F15</outgoing></scriptTask>
    <endEvent id="C_end" name="Artifacts uploaded"><incoming>F15</incoming></endEvent>
    <sequenceFlow id="F7" name="" sourceRef="C_start" targetRef="C_compile"/>
    <sequenceFlow id="F8" name="" sourceRef="C_compile" targetRef="C_stack"/>
    <sequenceFlow id="F9" name="" sourceRef="C_stack" targetRef="C_case"/>
    <sequenceFlow id="F10" name="" sourceRef="C_case" targetRef="C_collect"/>
    <sequenceFlow id="F11" name="" sourceRef="C_collect" targetRef="C_verdict"/>
    <sequenceFlow id="F12" name="" sourceRef="C_verdict" targetRef="C_gw"/>
    <sequenceFlow id="F13" name="yes" sourceRef="C_gw" targetRef="C_case"/>
    <sequenceFlow id="F14" name="no" sourceRef="C_gw" targetRef="C_export"/>
    <sequenceFlow id="F15" name="" sourceRef="C_export" targetRef="C_end"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
    <bpmndi:BPMNShape id="P_engineer_di" bpmnElement="P_engineer" isHorizontal="true"><dc:Bounds x="20" y="40" width="1680" height="160"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_ci_di" bpmnElement="P_ci" isHorizontal="true"><dc:Bounds x="20" y="240" width="1680" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_start_di" bpmnElement="E_start"><dc:Bounds x="80" y="102" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_spec_di" bpmnElement="E_spec"><dc:Bounds x="160" y="80" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_trigger_di" bpmnElement="E_trigger"><dc:Bounds x="310" y="80" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_investigate_di" bpmnElement="E_investigate"><dc:Bounds x="1210" y="80" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_gw_di" bpmnElement="E_gw" isMarkerVisible="true"><dc:Bounds x="1365" y="95" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_raise_di" bpmnElement="E_raise"><dc:Bounds x="1460" y="80" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_end_di" bpmnElement="E_end"><dc:Bounds x="1620" y="102" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_start_di" bpmnElement="C_start"><dc:Bounds x="340" y="312" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_compile_di" bpmnElement="C_compile"><dc:Bounds x="420" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_stack_di" bpmnElement="C_stack"><dc:Bounds x="560" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_case_di" bpmnElement="C_case"><dc:Bounds x="700" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_collect_di" bpmnElement="C_collect"><dc:Bounds x="840" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_verdict_di" bpmnElement="C_verdict"><dc:Bounds x="980" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_gw_di" bpmnElement="C_gw" isMarkerVisible="true"><dc:Bounds x="1115" y="305" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_export_di" bpmnElement="C_export"><dc:Bounds x="1210" y="290" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="C_end_di" bpmnElement="C_end"><dc:Bounds x="1360" y="312" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="98" y="120"/><di:waypoint x="210" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="210" y="120"/><di:waypoint x="360" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="1260" y="120"/><di:waypoint x="1390" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="1390" y="120"/><di:waypoint x="1510" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1390" y="95"/><di:waypoint x="1390" y="60"/><di:waypoint x="1638" y="60"/><di:waypoint x="1638" y="102"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1510" y="120"/><di:waypoint x="1638" y="120"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="358" y="330"/><di:waypoint x="470" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="470" y="330"/><di:waypoint x="610" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="610" y="330"/><di:waypoint x="750" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="750" y="330"/><di:waypoint x="890" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="890" y="330"/><di:waypoint x="1030" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1030" y="330"/><di:waypoint x="1140" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1140" y="355"/><di:waypoint x="1140" y="400"/><di:waypoint x="750" y="400"/><di:waypoint x="750" y="370"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1140" y="330"/><di:waypoint x="1260" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1260" y="330"/><di:waypoint x="1378" y="330"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="360" y="160"/><di:waypoint x="360" y="250"/><di:waypoint x="358" y="250"/><di:waypoint x="358" y="312"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="M2_di" bpmnElement="M2"><di:waypoint x="1260" y="290"/><di:waypoint x="1260" y="160"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
