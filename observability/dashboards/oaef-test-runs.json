{
  "uid": "oaef-test-runs",
  "title": "OAEF \u2014 Test runs",
  "description": "Verdicts published by Jarvis (oaef.test.verdict): one row per run, with its classes and a link to its report.",
  "tags": [
    "oaef"
  ],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs by verdict",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({service_name=\"oaef-jarvis\"} | json [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PASS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FAIL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INCONCLUSIVE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Failures by diagnostic class",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "expr": "sum by (cls) (count_over_time({service_name=\"oaef-jarvis\"} | json status, cls=\"classes[0]\" | status != \"PASS\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{cls}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Verdicts over time",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({service_name=\"oaef-jarvis\"} | json [$__interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Runs (click run_id for its journey, report_url for its report)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "expr": "{service_name=\"oaef-jarvis\"} | json",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "run_id": true,
              "test_case": true,
              "fault": true,
              "status": true,
              "classes": true,
              "failed_checks": true,
              "transactions": true,
              "report_url": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "report_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the test report",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Journey dashboard of this run",
                    "url": "/d/oaef-journey/oaef-journey?var-run_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PASS": {
                        "color": "green"
                      },
                      "FAIL": {
                        "color": "red"
                      },
                      "INCONCLUSIVE": {
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "links": [
    {
      "title": "OAEF \u2014 Journey",
      "type": "link",
      "url": "/d/oaef-journey/oaef-journey"
    }
  ]
}
