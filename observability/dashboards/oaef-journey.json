{
  "uid": "oaef-journey",
  "title": "OAEF \u2014 Journey",
  "description": "One test run: service graph, per-service requests and latency (run-scoped), journey histogram with exemplars, span-metrics RED, the run's traces, business events and verdict.",
  "tags": [
    "oaef"
  ],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "label": "Tempo",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "run_id",
        "type": "query",
        "label": "Run",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "refresh": 2,
        "sort": 0,
        "query": {
          "query": "label_values(oaef_synthetic_journey_duration_seconds_count, oaef_run_id)",
          "refId": "run"
        },
        "current": {},
        "options": []
      },
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{oaef_run_id=\"$run_id\"}, service_name)",
          "refId": "svc"
        },
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "Service graph (Tempo, all runs in the time range)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "queryType": "serviceMap",
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Transactions in this run",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "expr": "sum(last_over_time(oaef_synthetic_journey_duration_seconds_count{oaef_run_id=\"$run_id\"}[$__range]))",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Verdict of this run",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "expr": "sum by (status) (count_over_time({service_name=\"oaef-jarvis\"} |= \"$run_id\" | json status [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name",
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Requests per service (this run)",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "expr": "sum by (service_name) (last_over_time(http_server_request_duration_seconds_count{oaef_run_id=\"$run_id\", service_name=~\"$service\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Mean server latency per service (this run)",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "expr": "sum by (service_name) (last_over_time(http_server_request_duration_seconds_sum{oaef_run_id=\"$run_id\", service_name=~\"$service\"}[$__range])) / sum by (service_name) (last_over_time(http_server_request_duration_seconds_count{oaef_run_id=\"$run_id\", service_name=~\"$service\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Journey duration buckets of this run (exemplars open the trace)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "expr": "sum by (le) (oaef_synthetic_journey_duration_seconds_bucket{oaef_run_id=\"$run_id\"})",
          "exemplar": true,
          "legendFormat": "le {{le}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RED from span metrics: request rate per service",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        },
        {
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "errors {{service}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Traces of this run (click a trace id)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ span.oaef.run.id = \"$run_id\" }",
          "tableType": "traces",
          "limit": 100,
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p95 latency per service (span metrics)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Business events of this run",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "expr": "{service_name=~\".+\"} |= \"$run_id\" | json | event_name =~ \".+\"",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      }
    }
  ],
  "links": [
    {
      "title": "OAEF \u2014 Test runs",
      "type": "link",
      "url": "/d/oaef-test-runs/oaef-test-runs"
    }
  ]
}
